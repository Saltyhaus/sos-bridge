<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only permission this app needs: talk to the SOS bridge endpoint over HTTP(S). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme">

        <!--
          Catches the TE320's firmware-level SOS.longpress broadcast and fires the
          configured HTTP alert. android:exported="true" is required: this is a
          broadcast sent from the system (uid android), not from our own app, so the
          receiver must be reachable from outside our package.

          Manifest-registered (not just runtime-registered) so this fires even if the
          app process isn't already running when the button is pressed, as long as
          the package isn't sitting in Android's "stopped" state. See README.md for the
          one-time adb step that clears that after a fresh install, same as com.z3.dmr
          and news.androidtv.launchonboot needed on this device.
        -->
        <receiver
            android:name=".SosReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.SOS.longpress" />
            </intent-filter>
        </receiver>

        <!--
          Status/test screen. Also exists so there's a launcher icon to tap once after
          install: launching it clears the app's "stopped" flag, which is what
          actually lets the receiver above start receiving broadcasts at all.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>